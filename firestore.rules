rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Wishes collection for Ankush & Yamini's Wedding Guestbook
    match /wishes/{wishId} {
      // Anyone can read wishes (client filters for status == 'approved')
      allow read: if true;

      // Anyone can submit a respectful wish with valid author and text, marked as 'pending'
      allow create: if request.resource.data.author is string
                    && request.resource.data.author.size() > 0
                    && request.resource.data.author.size() <= 80
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 1000
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is timestamp;

      // Approvals (updating status to 'approved') and removals
      allow update, delete: if true;
    }
  }
}
